// Settings shared by every configuration and target. Debug/Release include this first.

MACOSX_DEPLOYMENT_TARGET = 27.0
SDKROOT = macosx

SWIFT_VERSION = 6.0
SWIFT_STRICT_CONCURRENCY = complete
SWIFT_DEFAULT_ACTOR_ISOLATION = MainActor
SWIFT_UPCOMING_FEATURE_MEMBER_IMPORT_VISIBILITY = YES

PRODUCT_BUNDLE_IDENTIFIER = io.blacktop.Usage
MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1

INFOPLIST_FILE = App/Info.plist
CODE_SIGN_ENTITLEMENTS = Config/Usage.entitlements

// The Icon Composer bundle at Resources/Usage.icon; the asset compiler injects CFBundleIconName.
ASSETCATALOG_COMPILER_APPICON_NAME = Usage

// Ad-hoc is the fallback, not the intent. An ad-hoc signature has no stable designated
// requirement, so a Keychain ACL cannot record it durably: every rebuild is a new principal and
// re-prompts for access. Config/Local.xcconfig (gitignored, included below) supplies the stable
// Apple Development identity. `just check-signing` fails when a build lands here instead.
CODE_SIGN_IDENTITY = -
CODE_SIGN_STYLE = Manual
CODE_SIGNING_REQUIRED = YES
DEVELOPMENT_TEAM =

// Hardened Runtime plus the macOS 26 Enhanced Security suite (MIE/MTE hard mode, pointer
// authentication, typed allocators), mirroring PBnJ. The sandbox stays off: Usage's whole job is
// reading other agents' configuration files and login-keychain items, which a sandboxed process
// cannot reach. `just verify-security` audits the built product for all of this.
ENABLE_HARDENED_RUNTIME = YES
ENABLE_ENHANCED_SECURITY = YES
ENABLE_POINTER_AUTHENTICATION = YES
CLANG_ENABLE_C_TYPED_ALLOCATOR_SUPPORT = YES
CLANG_ENABLE_CPLUSPLUS_TYPED_ALLOCATOR_SUPPORT = YES
CLANG_ENABLE_STACK_ZERO_INIT = YES
ENABLE_CPLUSPLUS_BOUNDS_SAFE_BUFFERS = YES
ENABLE_SECURITY_COMPILER_WARNINGS = YES
ENABLE_APP_SANDBOX = NO

SWIFT_TREAT_WARNINGS_AS_ERRORS = YES
GCC_TREAT_WARNINGS_AS_ERRORS = YES
SWIFT_WARNINGS_AS_ERRORS_EXCEPTIONS =
CLANG_ANALYZER_NONNULL = YES
CLANG_WARN_DOCUMENTATION_COMMENTS = YES
GCC_WARN_UNDECLARED_SELECTOR = YES
GCC_NO_COMMON_BLOCKS = YES

// Nothing here uses App Intents. Without this, appintentsmetadataprocessor prints a
// "Metadata extraction skipped, no AppIntents.framework dependency found" warning on every
// build of the app and the test bundle. Delete this line if an App Intent is ever added.
LM_SKIP_METADATA_EXTRACTION = YES

ALWAYS_SEARCH_USER_PATHS = NO
DEAD_CODE_STRIPPING = YES
ENABLE_USER_SCRIPT_SANDBOXING = YES
COMBINE_HIDPI_IMAGES = YES
